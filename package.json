{
  "name": "bil233",
  "version": "1.0.0",
  "description": "Local visual workbench for blrec/Bilibili live recording assets.",
  "main": "server/dev.mjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/dev.mjs",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:qwen": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1 -WithQwen -QwenModelSize 0.6B",
    "start:workbench": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1"
  },
  "keywords": [],
  "author": "",
