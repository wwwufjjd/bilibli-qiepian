  "type": "commonjs",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.17.0",
    "mime-types": "^3.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
